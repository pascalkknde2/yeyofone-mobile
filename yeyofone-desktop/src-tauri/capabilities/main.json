{
  "identifier": "main-window",
  "description": "Validated runtime and account commands, plus listening for native call-state events, for the local main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-runtime-status",
    "allow-accounts-command",
    "allow-registration-command",
    "allow-validate-destination",
    "allow-calls-command",
    "allow-call-history-command",
    "allow-recording-file-command",
    "allow-recording-cloud-command",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
