{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YeyoFone",
  "version": "0.1.0",
  "identifier": "com.yeyofone.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev -- --port 5175 --strictPort",
      "cwd": "../frontend"
    },
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YeyoFone",
        "width": 1440,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/call-recordings/**"] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../native/licenses/OpenSSL-Apache-2.0.txt": "licenses/OpenSSL-Apache-2.0.txt",
      "../native/licenses/libsrtp-BSD.txt": "licenses/libsrtp-BSD.txt",
      "../native/licenses/PJSIP-GPL-2.0.txt": "licenses/PJSIP-GPL-2.0.txt",
      "../native/licenses/libresample-LGPL-2.1.txt": "licenses/libresample-LGPL-2.1.txt"
    }
  }
}
