<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11 counterpart of data_extraction_rules.xml. allowBackup="false" already disables
    backup there; this keeps credentials excluded even if that flag is ever changed, because
    Keystore-sealed secrets cannot be restored to another device or installation.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
